# Django
SECRET_KEY=change-me
MODE=prod
DEBUG_ENABLED=False
ALLOWED_HOSTS=localhost,127.0.0.1,<your-vm-ip>
CSRF_TRUSTED_ORIGINS=http://localhost:8020,http://<your-vm-ip>:8020

# Database
DB_NAME=trucksigns_db
DB_USER=trucksigns_user
